generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  SCRAP_YARD
  DEMOLITION
  SHIP_BREAKER
  MANUFACTURER
  RECYCLER
  TRADER
  BROKER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ListingType {
  SELL
  BUY
  WANTED
  AUCTION
}

enum MaterialCategory {
  FERROUS_METALS
  NON_FERROUS_METALS
  ENGINES_DRIVETRAIN
  ELECTRIC_MOTORS
  PIPING_FITTINGS
  TANKS_VESSELS
  HEAVY_MACHINERY
  MARINE_OFFSHORE
  RAIL_TRANSPORT
  AEROSPACE
  CONSTRUCTION_DEMOLITION
  ELECTRONIC_ELECTRICAL
  PRECIOUS_SPECIALTY
  INDUSTRIAL_EQUIPMENT
}

enum Condition {
  COMPLETE
  PARTIAL
  DAMAGED
  AS_IS
  SCRAP_ONLY
}

enum Unit {
  TONS
  LBS
  KG
  PIECES
  LOT
}

enum ListingStatus {
  ACTIVE
  EXPIRED
  SOLD
  DRAFT
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum RFQStatus {
  OPEN
  CLOSED
  AWARDED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  businessType       BusinessType
  verificationStatus VerificationStatus @default(UNVERIFIED)
  ein                String?
  licenseNumber      String?
  address            String?
  city               String
  state              String
  country            String             @default("US")
  zipCode            String?
  phone              String?
  email              String
  website            String?
  description        String?
  logoUrl            String?
  memberSince        DateTime           @default(now())
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listings          Listing[]
  sentInquiries     Inquiry[]   @relation("InquiryFrom")
  receivedInquiries Inquiry[]   @relation("InquiryTo")
  rfqs              RFQ[]
  reviewsGiven      Review[]    @relation("ReviewFrom")
  reviewsReceived   Review[]    @relation("ReviewTo")
  users             User[]
}

model Listing {
  id                  String           @id @default(cuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id])
  listingType         ListingType
  title               String
  materialCategory    MaterialCategory
  materialSubcategory String?
  grade               String?
  condition           Condition
  quantity            Float
  unit                Unit
  pricePerUnit        Float?
  currency            String           @default("USD")
  negotiable          Boolean          @default(false)
  minOrder            Float?
  description         String?
  specs               String?
  location            String?
  city                String
  state               String
  country             String           @default("US")
  pickupAvailable     Boolean          @default(true)
  deliveryAvailable   Boolean          @default(false)
  expiresAt           DateTime?
  status              ListingStatus    @default(ACTIVE)
  viewCount           Int              @default(0)
  inquiryCount        Int              @default(0)
  qualityScore        Int              @default(0)
  photos              String[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  inquiries Inquiry[]
}

model Inquiry {
  id            String        @id @default(cuid())
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id])
  fromCompanyId String
  fromCompany   Company       @relation("InquiryFrom", fields: [fromCompanyId], references: [id])
  toCompanyId   String
  toCompany     Company       @relation("InquiryTo", fields: [toCompanyId], references: [id])
  message       String
  contactName   String
  contactPhone  String?
  contactEmail  String
  status        InquiryStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  messages Message[]
}

model Message {
  id              String   @id @default(cuid())
  inquiryId       String
  inquiry         Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderCompanyId String
  body            String
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([inquiryId, createdAt])
}

enum MatchStatus {
  NEW
  SEEN
  DISMISSED
  CONTACTED
}

model MatchAlert {
  id        String      @id @default(cuid())
  rfqId     String
  listingId String
  score     Float
  reasons   String[]
  status    MatchStatus @default(NEW)
  createdAt DateTime    @default(now())

  @@unique([rfqId, listingId])
}

model RFQ {
  id                  String           @id @default(cuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id])
  title               String
  materialCategory    MaterialCategory
  materialSubcategory String?
  quantityNeeded      Float
  unit                Unit
  targetPrice         Float?
  deliveryLocation    String?
  neededBy            DateTime?
  description         String?
  status              RFQStatus        @default(OPEN)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Review {
  id              String   @id @default(cuid())
  fromCompanyId   String
  fromCompany     Company  @relation("ReviewFrom", fields: [fromCompanyId], references: [id])
  toCompanyId     String
  toCompany       Company  @relation("ReviewTo", fields: [toCompanyId], references: [id])
  rating          Int
  comment         String?
  transactionType String?
  createdAt       DateTime @default(now())
}

model SavedSearch {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  filters      Json
  alertEnabled Boolean   @default(false)
  lastAlerted  DateTime?
  createdAt    DateTime  @default(now())
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  accounts      Account[]
  sessions      Session[]
  savedSearches SavedSearch[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// MARKET INTELLIGENCE
// Benchmark + scrap-grade price series, the dated events that
// explain their moves, and stored forward projections.
// Addresses Flag #3 (live metal price feed): ticks are written by
// a loader, so swapping the sample seed for a real feed touches
// only the loader, never the consumers.
// ============================================================

enum PriceSource {
  SAMPLE // synthesised seed data — clearly labelled in the UI
  MANUAL // hand-entered by an admin
  FEED   // ingested from a live provider
}

enum QuoteUnit {
  USD_LB
  USD_TON
  USD_CWT
}

// Ferrous grades quote in USD/ton; copper and brass in USD/lb.
enum MarketSymbol {
  CU_COMEX      // copper, COMEX benchmark
  CU_BARE_BRIGHT
  CU_NO2
  BRASS_YELLOW
  AL_EXTRUSION
  HMS_1
  HMS_12
  SHRED_STEEL
  BUSHELING
  SS_304
}

enum EventCategory {
  POLICY
  SUPPLY
  DEMAND
  INVENTORY
  MACRO
  FORECAST
}

model PriceSeries {
  id          String       @id @default(cuid())
  symbol      MarketSymbol @unique
  label       String
  unit        QuoteUnit
  source      PriceSource  @default(SAMPLE)
  // benchmark series drive derived grades; grades reference their benchmark
  benchmarkOf MarketSymbol?
  ticks       PriceTick[]
  events      MarketEvent[]
  forecasts   PriceForecast[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PriceTick {
  id       String      @id @default(cuid())
  seriesId String
  series   PriceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  // date is the settlement day; time-of-day is not meaningful here
  date     DateTime    @db.Date
  close    Float
  // point-in-time discipline: when we learned this print, so a
  // backtest can never see a revision before it was published
  observedAt DateTime  @default(now())

  @@unique([seriesId, date])
  @@index([seriesId, date])
}

model MarketEvent {
  id        String        @id @default(cuid())
  seriesId  String
  series    PriceSeries   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  category  EventCategory
  headline  String
  body      String
  // signed price impact on the day, percent, e.g. -3.1
  impactPct Float?
  sourceName String
  sourceUrl  String?
  createdAt DateTime      @default(now())

  @@index([seriesId, date])
}

model PriceForecast {
  id        String      @id @default(cuid())
  seriesId  String
  series    PriceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  // the day the forecast was made — everything after is out-of-sample
  runDate   DateTime    @db.Date
  horizonD  Int
  targetDate DateTime   @db.Date
  p10       Float
  p25       Float
  p50       Float
  p75       Float
  p90       Float
  // which estimator produced this, so a naive baseline is never
  // silently presented as a trained model
  method    String      @default("random-walk-drift")
  createdAt DateTime    @default(now())

  @@unique([seriesId, runDate, targetDate])
  @@index([seriesId, runDate])
}
